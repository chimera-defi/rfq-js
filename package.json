{
  "name": "rfq-system",
  "version": "1.0.0",
  "description": "A simple Request for Quote (RFQ) system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
